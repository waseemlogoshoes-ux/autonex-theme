{"sections":{"main":{"type":"main-product","blocks":{"judge_me_reviews_preview_badge_M3rceD":{"type":"shopify:\/\/apps\/judge-me-reviews\/blocks\/preview_badge\/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8","settings":{}},"description":{"type":"description","settings":{"is_tab":false}},"price":{"type":"price","settings":{}},"custom_ijyNjD":{"type":"custom","name":"Jazz BNPL","settings":{"code":"<style>\n  .jazzcash-gateway-wrapper {\n    margin-bottom: 12px;\n    margin-top: -8px;\n  }\n  .jazzcash-para {\n    display: flex;\n    justify-content: flex-start;\n    align-items: center;\n    gap: 6px;\n  }\n  .jazzcash-logo-wrapper {\n    display: flex;\n  }\n  .jazzcash-modal-trigger {\n    display: inline-flex;\n    cursor: pointer;\n    text-decoration: none;\n  }\n  .jazzcash-modal-trigger img {\n    width: 90px;\n    height: auto;\n  }\n  .jazzcash-price {\n    display: flex;\n    align-items: center;\n    gap: 5px;\n  }\n  .jazzcash-price p {\n    margin: 0;\n    line-height: 1;\n    font-size: 18px;\n    color: #000;\n    font-weight: 400;\n  }\n  .jazzcash-price .jc-currency,\n  .jazzcash-price .jc-amount {\n    color: #001EFF;\n    font-weight: 600;\n  }\n\n  \/* Popup Overlay *\/\n  .jazzcash-overlay {\n    display: none;\n    position: fixed;\n    top: 0; left: 0;\n    width: 100%; height: 100%;\n    background: rgba(0,0,0,0.7);\n    z-index: 99999;\n    justify-content: center;\n    align-items: center;\n  }\n  .jazzcash-overlay.active {\n    display: flex;\n  }\n  .jazzcash-popup {\n    position: relative;\n    max-width: 500px;\n    width: 90%;\n    border-radius: 16px;\n    overflow: hidden;\n    background: #fff;\n  }\n  .jazzcash-popup img.popup-img {\n    width: 100%;\n    height: auto;\n    display: block;\n  }\n  .jazzcash-close-btn {\n    position: absolute;\n    top: 12px; right: 14px;\n    background: rgba(0,0,0,0.5);\n    border: none;\n    color: #fff;\n    font-size: 20px;\n    width: 32px; height: 32px;\n    border-radius: 50%;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    line-height: 1;\n    z-index: 10;\n  }\n\n  @media (max-width: 765px) {\n    .jazzcash-para {\n      justify-content: center;\n    }\n    .jazzcash-modal-trigger img {\n      width: 90px;\n    }\n  }\n  @media (max-width: 420px) {\n    .jazzcash-modal-trigger img {\n      width: 80px;\n    }\n    .jazzcash-price p {\n      font-size: 13px;\n    }\n  }\n<\/style>\n\n<div class=\"jazzcash-gateway-wrapper\">\n  <div class=\"jazzcash-para\">\n    <!-- Logo -->\n    <div class=\"jazzcash-logo-wrapper\">\n      <a class=\"jazzcash-modal-trigger\" onclick=\"document.getElementById('jc-overlay').classList.add('active'); return false;\" href=\"#\">\n        <img \n          src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0097\/2075\/8332\/files\/Jazz_BNPL_logo.png?v=1779831380\" \n          alt=\"JazzCash Buy Now Pay Later\"\n        >\n      <\/a>\n    <\/div>\n    <!-- Price Text -->\n    <div class=\"jazzcash-price\">\n      <p>Pay in 3 Installments of<\/p>\n      <p class=\"jc-currency\">Rs.<\/p>\n      <p class=\"jc-amount\" id=\"jc-installment-amount\">\n        <!-- Amount will be set by JS -->\n      <\/p>\n  \n    <\/div>\n  <\/div>\n<\/div>\n\n<!-- Popup Overlay -->\n<div class=\"jazzcash-overlay\" id=\"jc-overlay\">\n  <div class=\"jazzcash-popup\">\n    <button class=\"jazzcash-close-btn\" onclick=\"document.getElementById('jc-overlay').classList.remove('active')\">✕<\/button>\n    <img \n      class=\"popup-img\"\n      src=\" https:\/\/cdn.shopify.com\/s\/files\/1\/0097\/2075\/8332\/files\/popup_bnpl.webp?v=1779827916\" \n      alt=\"JazzCash BNPL\"\n    >\n  <\/div>\n<\/div>\n\n<script>\n  (function() {\n    \/\/ Get price from Shopify variant price meta tag or data attribute\n    var priceEl = document.querySelector('[data-product-price]') || \n                  document.querySelector('.price__regular .price-item') ||\n                  document.querySelector('.product__price .price');\n    \n    \/\/ Try to get price in PKR (paise\/cents format from Shopify)\n    var rawPrice = 0;\n    \n    \/\/ Method 1: from data attribute set by theme\n    var priceData = document.querySelector('[data-price]');\n    if (priceData) {\n      rawPrice = parseInt(priceData.getAttribute('data-price')) \/ 100;\n    }\n    \n    \/\/ Method 2: parse from displayed price text\n    if (!rawPrice && priceEl) {\n      var priceText = priceEl.innerText.replace(\/[^0-9]\/g, '');\n      rawPrice = parseInt(priceText) || 0;\n    }\n\n    function formatAmount(num) {\n      return Math.round(num).toString().replace(\/\\B(?=(\\d{3})+(?!\\d))\/g, ',');\n    }\n\n    function updateJCAmount(price) {\n      var installment = Math.round((price * 1.15) \/ 3);\n      var el = document.getElementById('jc-installment-amount');\n      if (el) el.innerText = formatAmount(installment);\n    }\n\n    if (rawPrice > 0) {\n      updateJCAmount(rawPrice);\n    }\n\n    \/\/ Listen for variant change (price update)\n    document.addEventListener('variant:change', function(e) {\n      if (e.detail && e.detail.variant && e.detail.variant.price) {\n        updateJCAmount(e.detail.variant.price \/ 100);\n      }\n    });\n\n    \/\/ Also watch for price DOM changes\n    var observer = new MutationObserver(function() {\n      var el = document.querySelector('[data-price]');\n      if (el) {\n        var p = parseInt(el.getAttribute('data-price')) \/ 100;\n        if (p > 0) updateJCAmount(p);\n      }\n    });\n    var priceContainer = document.querySelector('.product__price, .price__container, [data-product-price]');\n    if (priceContainer) {\n      observer.observe(priceContainer, { childList: true, subtree: true, attributes: true });\n    }\n\n    \/\/ Close popup on overlay click\n    document.getElementById('jc-overlay').addEventListener('click', function(e) {\n      if (e.target === this) this.classList.remove('active');\n    });\n  })();\n<\/script>"}},"separator":{"type":"separator"
n\n.popup-content img {\n    max-width: 100%;\n    max-height: 100%;\n    display: block;\n    border-radius: 10px;\n}\n\n\/* Media Query for Desktop View *\/\n@media (min-width: 500px) {\n    .popup-content {\n        max-width: 500px; \/* Desktop ke liye max-width *\/\n        max-height: 500px; \/* Desktop ke liye max-height *\/\n    }\n}\n\n.close-button {\n    position: absolute;\n    top: -25px;\n    right: -25px;\n    background: #fff;\n    color: #000;\n    border-radius: 50%;\n    width: 30px;\n    height: 30px;\n    font-size: 25px;\n    font-weight: bold;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    cursor: pointer;\n    z-index: 1001;\n    transition: transform 0.3s ease;\n}\n\n.close-button:hover {\n    transform: rotate(90deg);\n    background: #f44336;\n    color: #fff;\n}\n\n@keyframes zoomIn {\n    from {\n        transform: scale(0.5);\n        opacity: 0;\n    }\n    to {\n        transform: scale(1);\n        opacity: 1;\n    }\n}\n<\/style>\n\n<div class=\"image-popup-container\">\n    <button class=\"popup-button\" onclick=\"openPopup()\">\n        <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0097\/2075\/8332\/files\/Jazz_paynow_by_later.png?v=1757192275\" alt=\"First Image\">\n    <\/button>\n\n    <div id=\"imagePopup\" class=\"popup\">\n        <div class=\"popup-content\">\n            <span class=\"close-button\" onclick=\"closePopup()\">&times;<\/span>\n            <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0097\/2075\/8332\/files\/image006.png?v=1757193015\" alt=\"Pop-up Image\">\n        <\/div>\n    <\/div>\n<\/div>\n\n<script>\n\/\/ JavaScript for pop-up functionality\n\nfunction openPopup() {\n    document.getElementById('imagePopup').style.display = 'flex';\n}\n\nfunction closePopup() {\n    document.getElementById('imagePopup').style.display = 'none';\n}\n\n\/\/ Close the pop-up if the user clicks outside the content\nwindow.onclick = function(event) {\n    const popup = document.getElementById('imagePopup');\n    if (event.target === popup) {\n        popup.style.display = 'none';\n    }\n}\n<\/script>"}},"essential_upsell_app_block_UApEQh":{"type":"shopify:\/\/apps\/essential-upsell\/blocks\/app-block\/50627fd9-24fd-4250-8614-accc12826d80","disabled":true,"settings":{}},"tab":{"type":"tab","settings":{"title":"Care Instructions","content":"","page":"care-instructions"}},"contact":{"type":"contact","settings":{"title":"Ask a question","phone":true}},"avada_order_limits_app_block_FUdrxi":{"type":"shopify:\/\/apps\/avada-order-limits\/blocks\/app-block\/d3021427-4f7b-49c8-8963-29d1d52b8956","settings":{}}},"block_order":["judge_me_reviews_preview_badge_M3rceD","description","price","custom_ijyNjD","separator","size_chart_JQH9xg","variant_picker","inventory_status","quantity_selector_mULLCn","trust_badge_fJdkgp","sales_point","buy_buttons","custom_FnkqWD","essential_upsell_app_block_UApEQh","tab","contact","avada_order_limits_app_block_FUdrxi"],"settings":{"sku_enable":true,"image_position":"left","image_size":"medium","product_zoom_enable":true,"thumbnail_position":"beside","thumbnail_height":"fixed","thumbnail_arrows":true,"mobile_layout":"partial","enable_video_looping":true,"product_video_style":"muted"}},"countdown_fYyPa8":{"type":"countdown","blocks":{"content_wjEnPy":{"type":"content","settings":{"heading":"HURRY UP! Time's running out.","heading_size":"h2","text":"<p>Experience the Ultimate Happy Hour! Enjoy Flat 40% Off + 5% Off on paid orders exclusively online.<\/p>","content_alignment":"center"}},"timer_emG8cN":{"type":"timer","settings":{"month":"07","day":"8","hour":"00","minute":"00","hide_timer":true,"text":""}}},"block_order":["content_wjEnPy","timer_emG8cN"],"disabled":true,"settings":{"layout":"banner","full_width":true,"text_color":"#ffffff","background_color":"#111111","overlay_color":"#000000","overlay_opacity":0}},"featured_collection_dWcwH3":{"type":"featured-collection","settings":{"title":"Frequently Bought Together","h